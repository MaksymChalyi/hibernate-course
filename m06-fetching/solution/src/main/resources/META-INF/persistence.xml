<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="minibank" transaction-type="RESOURCE_LOCAL">
        <class>ua.minibank.Customer</class>
        <class>ua.minibank.Account</class>
        <class>ua.minibank.Transaction</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/minibank?currentSchema=m06"/>
            <property name="jakarta.persistence.jdbc.user" value="minibank"/>
            <property name="jakarta.persistence.jdbc.password" value="minibank"/>

            <property name="hibernate.default_schema" value="m06"/>
            <property name="hibernate.hbm2ddl.create_namespaces" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.format_sql" value="true"/>
            <property name="hibernate.generate_statistics" value="true"/>

            <!--
                Глобальний batch fetching: lazy-зв'язки довантажуються пачками по 16 id
                замість одного запиту на кожен. Тут вимкнено, щоб N+1 був видимим.
                Тест BatchFetchTest вмикає його окремо і показує різницю.
            -->
            <!-- <property name="hibernate.default_batch_fetch_size" value="16"/> -->
        </properties>
    </persistence-unit>
</persistence>
