<?xml version="1.0" encoding="UTF-8"?>
<!--
    Головний файл налаштувань Hibernate (JPA). Hibernate шукає його саме тут:
    src/main/resources/META-INF/persistence.xml

    Persistence unit — «набір entity + як підключитися до бази».
    Ім'я "minibank" потім передається в Persistence.createEntityManagerFactory("minibank").
-->
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="minibank" transaction-type="RESOURCE_LOCAL">

        <!-- TODO 2.1 Зареєструй entity: рядок <class>ua.minibank.Customer</class> -->
        <!--     Hibernate не шукає entity по всьому проєкту сам: тут перелічено всі класи з @Entity.
                 Забудеш рядок — отримаєш помилку "Not an entity: class ua.minibank.Customer". -->

        <!-- Не шукати entity поза списком вище -->
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Підключення до бази — ті самі значення, що в Db.java для JDBC -->
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/minibank?currentSchema=m01"/>
            <property name="jakarta.persistence.jdbc.user" value="minibank"/>
            <property name="jakarta.persistence.jdbc.password" value="minibank"/>

            <!-- Схема модуля: Hibernate створить її, якщо її ще немає -->
            <property name="hibernate.default_schema" value="m01"/>
            <property name="hibernate.hbm2ddl.create_namespaces" value="true"/>

            <!-- TODO 2.2 Додай властивість hibernate.hbm2ddl.auto зі значенням create -->
            <!--     Рядок: <property name="hibernate.hbm2ddl.auto" value="create"/>
                     create = при кожному запуску видалити таблиці і створити заново за анотаціями entity.
                     Для навчання зручно (завжди чиста база), у реальному проєкті так не роблять. -->

            <!-- TODO 2.3 Додай властивість hibernate.format_sql зі значенням true -->
            <!--     Рядок: <property name="hibernate.format_sql" value="true"/>
                     SQL у консолі буде розбитий на рядки — його легше читати.
                     Сам SQL виводить логер org.hibernate.SQL, він уже увімкнений у logback.xml. -->
        </properties>
    </persistence-unit>
</persistence>
