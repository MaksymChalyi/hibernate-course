<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="minibank" transaction-type="RESOURCE_LOCAL">
        <class>ua.minibank.StatementLine</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/minibank?currentSchema=m10"/>
            <property name="jakarta.persistence.jdbc.user" value="minibank"/>
            <property name="jakarta.persistence.jdbc.password" value="minibank"/>

            <property name="hibernate.default_schema" value="m10"/>
            <property name="hibernate.hbm2ddl.create_namespaces" value="true"/>
            <!-- Таблицю створює Emfs.createSchema(). Інакше кожна нова фабрика стирала б дані -->
            <property name="hibernate.hbm2ddl.auto" value="none"/>
            <property name="hibernate.generate_statistics" value="true"/>

            <!-- Batching вмикається в Emfs.withBatching(). Тут вимкнено, щоб було з чим порівнювати -->
        </properties>
    </persistence-unit>
</persistence>
