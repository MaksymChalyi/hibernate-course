<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <persistence-unit name="minibank" transaction-type="RESOURCE_LOCAL">
        <!-- Entity -->
        <class>ua.minibank.Customer</class>
        <class>ua.minibank.Account</class>
        <!-- Вбудовувані класи (@Embeddable) теж перелічуємо -->
        <class>ua.minibank.Address</class>

        <!-- TODO 4.4 (резерв) Розкоментуй рядок нижче, коли Money стане @Embeddable -->
        <!-- <class>ua.minibank.Money</class> -->

        <!-- TODO 5.4 (ДЗ) Розкоментуй рядок нижче, коли CurrencyConverter буде готовий -->
        <!-- <class>ua.minibank.CurrencyConverter</class> -->

        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.jdbc.url" value="jdbc:postgresql://localhost:5432/minibank?currentSchema=m02"/>
            <property name="jakarta.persistence.jdbc.user" value="minibank"/>
            <property name="jakarta.persistence.jdbc.password" value="minibank"/>

            <property name="hibernate.default_schema" value="m02"/>
            <property name="hibernate.hbm2ddl.create_namespaces" value="true"/>
            <property name="hibernate.hbm2ddl.auto" value="create"/>
            <property name="hibernate.format_sql" value="true"/>
        </properties>
    </persistence-unit>
</persistence>
