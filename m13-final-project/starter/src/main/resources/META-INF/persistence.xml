<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!-- URL, користувач, пароль і схема приходять з AppConfig (див. AppContextListener) -->
    <persistence-unit name="minibank" transaction-type="RESOURCE_LOCAL">
        <class>ua.minibank.domain.Customer</class>
        <class>ua.minibank.domain.Account</class>
        <class>ua.minibank.domain.Transaction</class>
        <!-- TODO 2.2 Додати <class>ua.minibank.domain.StatementLine</class> -->
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!--
                Схемою керує Flyway (src/main/resources/db/migration).
                Hibernate лише перевіряє при старті, що таблиці й колонки відповідають entity.
                Розбіжність → застосунок не стартує, а не падає пізніше на запиті.
            -->
            <property name="hibernate.hbm2ddl.auto" value="validate"/>
            <property name="hibernate.connection.pool_size" value="20"/>
            <!-- TODO 2.3 Batching: hibernate.jdbc.batch_size = 50, hibernate.order_inserts = true -->
        </properties>
    </persistence-unit>
</persistence>
